{
  "name": "ski-guide-italy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.mjs && node scripts/copy-public-to-dist.mjs && node scripts/prerender.mjs",
    "build:no-prerender": "vite build && node scripts/generate-sitemap.mjs && node scripts/copy-public-to-dist.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "optimize-images": "node scripts/optimize-images.mjs",
    "update-image-refs": "node scripts/update-image-refs.mjs",
    "images:webp": "npm run optimize-images && npm run update-image-refs",
    "prune-raster": "node scripts/prune-raster-duplicates.mjs",
    "pack-site": "npm run prune-raster && npm run build && rm -f site.zip && cd dist && zip -qr ../site.zip .",
    "preview": "vite preview",
    "pdf:italy-tours-en": "node scripts/generate-all-italy-tour-pdfs-en.mjs",
    "pdf:como-venice-en": "node scripts/generate-all-italy-tour-pdfs-en.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^12.23.24",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.2.4",
    "react-intersection-observer": "^10.0.0",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dlv": "^1.1.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "vite": "^7.1.7"
  }
}
